APP_NAME=NISF Backend
APP_ENV=local
DEBUG=true
# Production example:
# APP_ENV=production
# DEBUG=false
# ALLOWED_ORIGINS=["https://your-frontend-domain.com"]
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=nisf
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174
LLM_PROVIDER=local
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
HUGGINGFACE_TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LOCAL_MODEL=nisf-deterministic-local
SENTIMENT_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
ALLOW_LLM_FALLBACK=true
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=1
MAX_REQUEST_BYTES=20000
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENABLED=true
